# =============================================================================
# Sparkloom — 本地开发环境变量模板
# 使用方法：cp .env.example web/.env.local && 编辑 web/.env.local 填入实际值
# =============================================================================

# ===== 数据库 =====
# 本地开发使用相对路径，数据库文件在项目根目录
DATABASE_URL=../data.db

# ===== 飞书应用（必须配置） =====
# 在飞书开放平台 https://open.feishu.cn 创建企业自建应用后获取
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
# 回调地址，本地开发用 localhost
FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback

# ===== Next.js 前端飞书配置（浏览器可见，不含敏感信息） =====
NEXT_PUBLIC_FEISHU_APP_ID=cli_xxx
NEXT_PUBLIC_FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback

# ===== JWT 密钥（必须修改！至少 32 位随机字符串） =====
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string

# ===== 管理员飞书 ID（逗号分隔，同步时强制保持 admin 角色，不被降级） =====
# 在飞书管理后台可查到 open_id，格式如 ou_xxxxx
ADMIN_IDS=

# ===== 内部服务间通信密钥（必须配置！） =====
# proxy → web 的内部调用鉴权，auto-sync 定时任务也使用此密钥
# 生成方法：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_API_KEY=

# ===== 敏感字段加密（强烈建议配置） =====
# AES-256-GCM 加密密钥，用于加密存储 API Key、AccessKey Secret 等敏感字段
# 未配置则敏感字段明文存储（不安全）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ===== 代理网关 =====
PROXY_PORT=3001
PROXY_INTERNAL_URL=http://127.0.0.1:3001
PUBLIC_PROXY_BASE_URL=http://localhost:3000/v1

# ===== CORS 跨域 =====
# 允许跨域请求的来源白名单（逗号分隔）
# 未配置则只允许 localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000
UPSTREAM_ALLOWED_HOSTS=api.deepseek.com,api.siliconflow.cn,open.bigmodel.cn,api.openai.com,api.anthropic.com

# ===== Web 服务端口（可选） =====
PORT=3000

# ===== 定时同步（可选） =====
# AUTO_SYNC_ENABLED=false 可完全关闭后台定时同步
# AUTO_SYNC_ON_STARTUP=false 可关闭容器启动后的补同步；每日定时同步不受影响
AUTO_SYNC_ENABLED=true
AUTO_SYNC_ON_STARTUP=true
AUTO_SYNC_STARTUP_DELAY_MS=120000
# 渠道余额自动同步间隔，单位分钟；默认每小时同步一次，不发送提醒。
BALANCE_SYNC_INTERVAL_MINUTES=60
# 余额不足提醒时间，北京时间，HH:mm 逗号分隔；提醒时会同步余额并发送管理员通知。
BALANCE_ALERT_TIMES=09:30,12:00,14:30,17:30
# 余额不足通知默认启用；设为 false 可临时关闭飞书余额提醒。
BALANCE_ALERT_NOTIFY_ENABLED=true
