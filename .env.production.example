# =============================================================================
# Sparkloom - production environment template
# Copy to .env and fill real values before running docker compose.
# =============================================================================

# Feishu app credentials. Create an internal app in https://open.feishu.cn.
FEISHU_APP_ID=<feishu_app_id>
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=https://ai.yourcompany.com/api/auth/feishu/callback
NEXT_PUBLIC_FEISHU_APP_ID=<feishu_app_id>
NEXT_PUBLIC_FEISHU_REDIRECT_URI=https://ai.yourcompany.com/api/auth/feishu/callback

# Public endpoint shown to employees in API key setup commands.
PUBLIC_PROXY_BASE_URL=https://ai.yourcompany.com/v1
MAX_USER_API_KEYS_PER_USER=5
USER_API_KEY_CREATE_COOLDOWN_SECONDS=60

# Required secrets. Generate fresh values for every environment.
# openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=
# openssl rand -hex 24
INTERNAL_API_KEY=

# Initial admin protection. Prefer ADMIN_IDS because Feishu open_id is stable.
# Fill real Feishu open_id values. Do not use placeholders such as ou_xxx.
ADMIN_IDS=

# Docker Compose host binding ports. docker-compose binds web/proxy to 127.0.0.1 only.
# PROXY_PORT is also read by railway/start.mjs as the in-container proxy port.
WEB_PORT=3000
PROXY_PORT=3001

# Railway single-image internal Web port. railway/start.mjs reads this for in-container routing.
WEB_PORT_INTERNAL=3000

# Internal service addresses in the Docker network.
DATABASE_URL=/data/data.db
WEB_URL=http://web:3000
PROXY_BASE_URL=http://proxy:3001
USAGE_QUEUE_FILE=/usage/usage-queue.jsonl
USAGE_DEAD_LETTER_FILE=/usage/usage-dead-letter.jsonl

# Browser origins allowed to call the proxy directly.
CORS_ALLOWED_ORIGINS=https://ai.yourcompany.com

# Production upstream provider host allowlist. Leave as-is unless a new provider is formally approved.
UPSTREAM_ALLOWED_HOSTS=api.deepseek.com,api.siliconflow.cn,open.bigmodel.cn,api.openai.com,api.anthropic.com

NODE_ENV=production

# Background sync. Daily schedules remain active when AUTO_SYNC_ENABLED=true.
# Startup sync is delayed by default so first admin page loads after deploy stay responsive.
AUTO_SYNC_ENABLED=true
AUTO_SYNC_ON_STARTUP=true
AUTO_SYNC_STARTUP_DELAY_MS=120000
# Balance sync interval in minutes. Default: hourly, no Feishu reminder.
BALANCE_SYNC_INTERVAL_MINUTES=60
# Balance-low reminder times in Beijing time, comma-separated HH:mm.
BALANCE_ALERT_TIMES=09:30,12:00,14:30,17:30
# Balance-low notifications are enabled by default; set false to suppress Feishu recharge reminders.
BALANCE_ALERT_NOTIFY_ENABLED=true

# Destructive maintenance operations. Keep false; enable only during approved maintenance.
ENABLE_INTERNAL_BILLING_RESET=false
ENABLE_PROXY_USAGE_QUEUE_CLEAR=false

# One-time handoff/DR backup drill. Keep disabled by default.
# To run a production startup drill, temporarily set both values, deploy once, record logs,
# then delete RUN_BACKUP_DRILL_ON_START.
RUN_BACKUP_DRILL_ON_START=false
BACKUP_DRILL_RUN_ID=

# Optional off-site backup upload. Recommended for Railway production because large
# volume downloads may timeout through the CLI. Cloudflare R2 uses S3-compatible
# credentials: endpoint=https://<account-id>.r2.cloudflarestorage.com, region=auto.
BACKUP_OBJECT_STORAGE_ENABLED=false
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=production

# Optional Railway volume path.
# RAILWAY_VOLUME_MOUNT_PATH=/data
