# 构建产物
.next/
**/.next/
dist/
out/
.turbo/

# 环境变量（敏感信息不入镜像）
.env
.env.local
.env.production
.env.*
**/.env
**/.env.*

# 数据库文件
*.db
*.sqlite
data.db

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo

# 系统文件
